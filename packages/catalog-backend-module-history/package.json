{
  "name": "@kunickiaj/backstage-plugin-catalog-backend-module-history",
  "version": "0.2.0",
  "description": "Backstage backend module that records every catalog EntityProvider mutation into a versioned history store.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "engines": {
    "node": "22 || 24"
  },
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "catalog",
    "pluginPackage": "@backstage/plugin-catalog-backend"
  },
  "configSchema": "config.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./reconcile-cli": "./src/bin/reconcile.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
    "lint:fix": "backstage-cli package lint --fix",
    "test": "backstage-cli package test --passWithNoTests",
    "bench:baseline": "backstage-cli package test --runInBand --watch=false --runTestsByPath src/benchmarks/catalogHistory.baseline.benchmark.ts --testMatch '**/*.benchmark.ts'",
    "test:watch": "backstage-cli package test --watch",
    "start": "backstage-cli package start",
    "tsc": "tsc",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "bin": {
    "reconcile-catalog-history": "./bin/reconcile-catalog-history.js"
  },
  "files": [
    "bin",
    "config.d.ts",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "backstage",
    "backstage-plugin",
    "backend-plugin-module",
    "catalog",
    "audit",
    "history"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kunickiaj/backstage-plugin-catalog-module-history"
  },
  "bugs": {
    "url": "https://github.com/kunickiaj/backstage-plugin-catalog-module-history/issues"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "^1.11.8",
    "@backstage/cli": "^0.36.7",
    "@backstage/plugin-catalog-backend": "4.0.2",
    "@types/jest": "^30.0.0",
    "@types/json-stable-stringify": "^1.2.0",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "@backstage/backend-defaults": "^0.18.1",
    "@backstage/backend-plugin-api": "^1.11.0",
    "@backstage/catalog-client": "^1.16.3",
    "@backstage/catalog-model": "^1.10.2",
    "@backstage/errors": "^1.3.2",
    "@backstage/plugin-catalog-node": "^2.2.6",
    "@backstage/plugin-permission-common": "^0.9.12",
    "@backstage/types": "^1.2.2",
    "@kunickiaj/backstage-plugin-catalog-history-common": "workspace:^",
    "@kunickiaj/backstage-plugin-catalog-history-node": "workspace:^",
    "@kunickiaj/backstage-plugin-catalog-history-storage-node": "workspace:^",
    "@types/express": "^4.17.25",
    "express": "^4.22.2",
    "express-promise-router": "^4.1.1",
    "json-stable-stringify": "^1.3.0",
    "knex": "^3.0.0",
    "pg": "^8.23.0"
  }
}
